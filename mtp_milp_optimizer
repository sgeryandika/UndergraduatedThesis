def parse_args():
    p = argparse.ArgumentParser()
    p.add_argument('--input', '-i', required=True, help="optimizer_input CSV (RowID, TaskID, IntervalFH, ManhoursRT, Men, Categories, Zone)")
    p.add_argument('--A_min', type=int, default=400)
    p.add_argument('--A_max', type=int, default=1000)
    p.add_argument('--A_step', type=int, default=100)
    p.add_argument('--C_min', type=int, default=4000)
    p.add_argument('--C_max', type=int, default=9000)
    p.add_argument('--C_step', type=int, default=1000)
    p.add_argument('--mode', type=str, default='equalized', choices=['equalized', 'block'])
    p.add_argument('--Wpeak', type=float, default=40.0, help="peak manhours capacity per package (manhour equivalent)")
    p.add_argument('--viz_horizon', type=int, default=50000)
    p.add_argument('--time_limit', type=int, default=300, help="solver time limit per MILP (s)")
    p.add_argument('--save_outputs', action='store_true')
    return p.parse_args()


def main():
    args = parse_args()
    params = Params()
    A_candidates = list(range(args.A_min, args.A_max + 1, args.A_step))
    C_candidates = list(range(args.C_min, args.C_max + 1, args.C_step))
    solver_options = {'TimeLimit': args.time_limit, 'MIPGap': 0.01}  # example options

    start = time.time()
    print(f"[INFO] Running MILP grid: A candidates={A_candidates}, C candidates={C_candidates}, mode={args.mode}")
    result = run_milp_grid(input_csv=args.input, A_candidates=A_candidates, C_candidates=C_candidates,
                          params=params, mode=args.mode, H_override=None, Wpeak=args.Wpeak,
                          viz_horizon=args.viz_horizon, solver_options=solver_options, save_outputs=args.save_outputs)

    best = result['best']
    if best is None:
        print("[WARN] No feasible configuration found by MILP.")
        return

    # Extract final best
    A_best = best['A']; C_best = best['C']
    locked_best = best['locked_df']
    tasks_df = result['tasks_df']
    exact_costs = best['exact_costs']

    print(f"[INFO] Best MILP configuration: A={A_best}, C={C_best}")
    print("Exact baseline-cost decomposition for chosen solution:")
    for k, v in exact_costs.items():
        print(f"  {k}: {v}")

    # Build validation DF and package summary using baseline helper logic
    # compact validation uses tasks_df, candidates (from best) and locked
    # Reuse baseline's build_compact_validation from earlier file; but we'll compute minimal fields here
    validation_df = pd.DataFrame()
    # Build package summary and matrix
    pkg_summary = build_package_summary_from_locked(locked_best, A_best, C_best, args.viz_horizon)
    task_bin_matrix = build_task_bin_matrix(locked_best, tasks_df)

    # Save outputs & plots
    tag = f"A{A_best}_C{C_best}_{args.mode}"
    if args.save_outputs:
        locked_best.to_csv(f"milp_locked_{tag}.csv", index=False)
        pkg_summary.to_csv(f"milp_pkg_summary_{tag}.csv", index=False)
        task_bin_matrix.to_csv(f"milp_task_bin_matrix_{tag}.csv", index=False)
    plot_package_histogram(pkg_summary, A_best, C_best, args.viz_horizon, savepath=f"milp_pkg_hist_{tag}.png")
    plot_occurrence_histogram(locked_best, args.viz_horizon, savepath=f"milp_occ_hist_{tag}.png")

    elapsed = time.time() - start
    print(f"[INFO] MILP grid completed in {elapsed:.1f}s. Outputs saved: {args.save_outputs}")
    print("[INFO] Done.")


if __name__ == "__main__":
