def plot_cumulative_cost(locked: pd.DataFrame,
                         tasks_df: pd.DataFrame,
                         params: Params,
                         A: int,
                         C: int,
                         viz_horizon: int,
                         savepath: Optional[str] = None):
    """
    Plot cumulative total cost over the horizon with event markers.
    - Step plot shows cost accumulation
    - Markers distinguish A vs C maintenance events
    - Vertical lines at C boundaries for reference
    """
    if locked is None or locked.empty:
        print("[WARN] plot_cumulative_cost skipped: no locked assignments.")
        return
    
    # Map men values
    men_map = dict(zip(tasks_df['task_id'].astype(str), tasks_df['men'].astype(float)))
    df = locked[locked['due'] <= viz_horizon].copy()
    df['men'] = df['task_id'].map(men_map).fillna(1.0)

    # Aggregate MH per due
    occ = df.groupby(['due', 'bin'], as_index=False).agg(
        mh=('mh', 'sum'),
        men=('men', 'sum')
    ).sort_values('due')

    # Compute cost per event with breakdown
    costs = []
    for _, row in occ.iterrows():
        mh, men = row['mh'], max(row['men'], 1.0)
        is_c = (row['bin'] % C == 0)

        # Direct + material
        direct_labour = params.labor_rate * mh
        direct = params.phi * direct_labour
        material = params.material_fraction * direct_labour

        # Overhead
        overhead = params.ohC if is_c else params.ohA

        # Downtime
        downtime_hours = mh / men
        downtime_cost = downtime_hours * params.revenue_per_hour

        event_cost = direct + material + overhead + downtime_cost
        costs.append({
            'due': row['due'],
            'bin': int(row['bin']),
            'is_c': is_c,
            'event_cost': event_cost,
            'mh': mh
        })

    cost_df = pd.DataFrame(costs)
    cost_df['cumulative_cost'] = cost_df['event_cost'].cumsum()

    # Create figure with better dimensions
    fig, ax = plt.subplots(figsize=(15, 6))

    # Separate A and C events for better visualization
    a_events = cost_df[~cost_df['is_c']]
    c_events = cost_df[cost_df['is_c']]

    # Step plot for cumulative cost
    ax.step(cost_df['due'], cost_df['cumulative_cost'], where='post', 
           color='darkred', linewidth=2.5, label='Cumulative Cost', zorder=3)

    # Scatter markers for events (A=circle, C=diamond)
    if not a_events.empty:
        ax.scatter(a_events['due'], a_events['cumulative_cost'], 
                  color='steelblue', s=80, marker='o', edgecolor='darkblue', 
                  linewidth=1.5, alpha=0.8, label='A-check events', zorder=4)
    
    if not c_events.empty:
        ax.scatter(c_events['due'], c_events['cumulative_cost'], 
                  color='orange', s=120, marker='D', edgecolor='darkorange', 
                  linewidth=1.5, alpha=0.8, label='C-check events', zorder=4)

    # Add vertical markers for C boundaries
    for c_mult in range(C, viz_horizon+1, C):
        ax.axvline(x=c_mult, color='grey', linestyle=':', alpha=0.3, linewidth=1.5)

    # Formatting
    ax.set_xlabel('Flight Hours (FH)', fontsize=11, fontweight='bold')
    ax.set_ylabel('Cumulative Maintenance Cost ($)', fontsize=11, fontweight='bold')
    ax.set_title(f'Cumulative Maintenance Cost Progression (0–{viz_horizon} FH)', 
                fontsize=12, fontweight='bold')
    
    # Format y-axis with thousands separator
    ax.yaxis.set_major_formatter(plt.FuncFormatter(lambda x, p: f'${x/1e6:.1f}M' if x >= 1e6 else f'${x/1e3:.0f}K'))
    
    ax.grid(True, linestyle='--', alpha=0.3)
    ax.set_xlim(0, viz_horizon * 1.02)
    
    # Add legend with final cost annotation
    final_cost = cost_df['cumulative_cost'].iloc[-1] if not cost_df.empty else 0
    legend_text = f'Final Cost: ${final_cost:,.0f}'
    ax.text(0.98, 0.05, legend_text, transform=ax.transAxes, 
           fontsize=11, fontweight='bold', ha='right', va='bottom',
           bbox=dict(boxstyle='round', facecolor='wheat', alpha=0.8))
    
    ax.legend(loc='upper left', fontsize=10, framealpha=0.95)

    fig.tight_layout()
    if savepath:
        fig.savefig(savepath, bbox_inches='tight', dpi=200)
    plt.close(fig)


def plot_cost_decomposition(costs: Dict[str, float],
                            savepath: Optional[str] = None):
    """
    Plot cost decomposition as a pie chart and stacked bar with values.
    - Left: Pie chart showing percentage breakdown
    - Right: Stacked bar showing absolute costs
    """
    if costs is None or not costs:
        print("[WARN] plot_cost_decomposition skipped: no cost data.")
        return

    # Extract components (only the incurred, not opportunity)
    labels = ['Direct\nLabour', 'Material', 'Overhead', 'Downtime', 'Line']
    values = [costs.get('direct', 0),
              costs.get('material', 0),
              costs.get('overhead', 0),
              costs.get('downtime', 0),
              costs.get('line_cost', 0)]
    colors = ['#FF9999', '#66B2FF', '#99FF99', '#FFD700', '#FF99CC']
    
    # Guard against all-zero values
    if sum(values) == 0:
        print("[WARN] plot_cost_decomposition skipped: all cost components are zero.")
        return

    # Create figure with two subplots
    fig, (ax_pie, ax_bar) = plt.subplots(1, 2, figsize=(14, 6))

    # --- PIE CHART (with percentages and values) ---
    total_incurred = sum(values)
    wedges, texts, autotexts = ax_pie.pie(
        values, 
        labels=labels, 
        autopct='%1.1f%%',
        startangle=90, 
        colors=colors,
        wedgeprops={'edgecolor': 'darkgray', 'linewidth': 1.5},
        textprops={'fontsize': 10, 'weight': 'bold'}
    )
    
    # Add values next to percentages
    for autotext, val in zip(autotexts, values):
        if val > 0:
            autotext.set_color('white')
            autotext.set_fontsize(9)
    
    ax_pie.set_title('Cost Decomposition (Percentage Share)', fontsize=11, fontweight='bold', pad=20)

    # --- STACKED BAR CHART (with absolute values and opportunity cost) ---
    x_pos = 0
    bottom = 0
    bar_segments = []
    
    for val, lab, col in zip(values, labels, colors):
        if val > 0:
            bar = ax_bar.bar(x_pos, val, bottom=bottom, label=lab.replace('\n', ' '), 
                            color=col, edgecolor='darkgray', linewidth=2, width=0.5)
            bar_segments.append((bottom, val, lab))
            bottom += val
    
    # Add total incurred cost annotation inside the bar
    ax_bar.text(x_pos, total_incurred / 2, f'Incurred\n${total_incurred/1e6:.2f}M',
               ha='center', va='center', fontsize=11, fontweight='bold', color='black')
    
    # Add opportunity cost as a separate segment
    opportunity = costs.get('opportunity_cost', 0)
    if opportunity > 0:
        ax_bar.text(x_pos + 0.35, total_incurred + opportunity / 2, 
                   f'Opportunity\n${opportunity/1e6:.2f}M',
                   ha='center', va='center', fontsize=10, fontweight='bold', 
                   color='white', bbox=dict(boxstyle='round', facecolor='grey', alpha=0.8))
    
    # Formatting
    ax_bar.set_xticks([x_pos])
    ax_bar.set_xticklabels(['Total Cost'], fontsize=11, fontweight='bold')
    ax_bar.set_ylabel('Cost ($)', fontsize=11, fontweight='bold')
    ax_bar.yaxis.set_major_formatter(plt.FuncFormatter(lambda x, p: f'${x/1e6:.1f}M' if x >= 1e6 else f'${x/1e3:.0f}K'))
    ax_bar.set_title('Cost Decomposition (Absolute Values)', fontsize=11, fontweight='bold', pad=20)
    ax_bar.set_ylim(0, total_incurred * 1.15)
    ax_bar.grid(axis='y', linestyle='--', alpha=0.3)
    
    # Summary text box
    total_with_opportunity = total_incurred + opportunity
    summary_text = (
        f'Total Incurred: ${total_incurred:,.0f}\n'
        f'Opportunity Cost: ${opportunity:,.0f}\n'
        f'Total with Opportunity: ${total_with_opportunity:,.0f}'
    )
    ax_bar.text(0.98, 0.97, summary_text, transform=ax_bar.transAxes,
               fontsize=10, va='top', ha='right', family='monospace',
               bbox=dict(boxstyle='round', facecolor='lightyellow', alpha=0.9, pad=0.7))

    fig.tight_layout()
    if savepath:
        fig.savefig(savepath, bbox_inches='tight', dpi=200)
    plt.close(fig)


