def plot_package_histogram(pkg_summary: pd.DataFrame,
                           tasks_df: pd.DataFrame,
                           params: Params,
                           A: int,
                           C: int,
                           viz_horizon: int,
                           savepath: Optional[str] = None):
    """
    Plot aggregated workload per package bin (A or C).
    - Bars represent total MH per package bin
    - Color: blue=A-check, orange=C-check
    - X-axis: package bin locations (FH)
    - Secondary axis: downtime hours
    - Grid lines for C boundaries
    """
    if pkg_summary is None or pkg_summary.empty:
        print("[WARN] plot_package_histogram skipped: no package summary data.")
        return

    fig, ax1 = plt.subplots(figsize=(14, 6))
    ax2 = ax1.twinx()

    # Track legends separately to avoid duplicates
    a_bars = []
    c_bars = []
    
    if pkg_summary is not None and not pkg_summary.empty:
        for idx, (_, row) in enumerate(pkg_summary.iterrows()):
            b = row['assigned_bin']
            lvl = row['assigned_level']
            mh_total = row['total_mh']
            task_count = row['task_count']

            # Color by package type
            is_c = (lvl == 'C')
            color = 'orange' if is_c else 'steelblue'
            width = (C * 0.5 if is_c else A * 0.5)

            # Plot bar
            bar = ax1.bar(b, mh_total, width=width, align='center',
                         edgecolor='darkgray', linewidth=1.5, alpha=0.75, color=color)
            if is_c:
                c_bars.append(bar)
            else:
                a_bars.append(bar)

            # Downtime hours estimate (using average men for all tasks in this bin)
            men_map = dict(zip(tasks_df['task_id'].astype(str), tasks_df['men'].astype(float)))
            avg_men = np.mean(list(men_map.values())) if men_map else 1.0
            downtime_hours = mh_total / max(avg_men, 1.0)

            # Plot downtime point on secondary axis
            ax2.scatter(b, downtime_hours, color='darkred', s=100, marker='D', zorder=5, alpha=0.7)

            # Single annotation: MH value at bar top
            ax1.text(b, mh_total + mh_total*0.03, f'{mh_total:.0f}MH', 
                    ha='center', va='bottom', fontsize=9, fontweight='bold')

    # Add vertical markers for C boundaries
    for c_mult in range(C, viz_horizon+1, C):
        ax1.axvline(x=c_mult, color='grey', linestyle=':', alpha=0.4, linewidth=1)

    ax1.set_xlabel('Flight Hours (FH)', fontsize=11, fontweight='bold')
    ax1.set_ylabel('Total Manhours per Package (MH)', fontsize=11, fontweight='bold', color='black')
    ax2.set_ylabel('Downtime Hours per Package (h)', fontsize=11, fontweight='bold', color='darkred')
    ax2.tick_params(axis='y', labelcolor='darkred')

    ax1.set_title(f'Package Workload Distribution (0–{viz_horizon} FH)', fontsize=12, fontweight='bold')
    ax1.grid(axis='y', linestyle='--', alpha=0.3)
    ax1.set_xlim(0, viz_horizon * 1.02)

    # Legend with proper handles
    handles = [
        mpatches.Patch(facecolor='steelblue', edgecolor='darkgray', label='A-check packages', alpha=0.75),
        mpatches.Patch(facecolor='orange', edgecolor='darkgray', label='C-check packages', alpha=0.75),
        plt.Line2D([0], [0], color='grey', linestyle=':', linewidth=2, label='C-check boundaries'),
        plt.Line2D([0], [0], color='darkred', marker='D', linestyle='None', markersize=8, label='Downtime hours')
    ]
    ax1.legend(handles=handles, loc='upper left', fontsize=10, framealpha=0.95)

    fig.tight_layout()
    if savepath:
        fig.savefig(savepath, bbox_inches='tight', dpi=200)
