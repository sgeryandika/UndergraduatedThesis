    def run_optimizer(self, script_path: str, label: str):
        """
        Windows-safe, error-proof optimizer launcher.
        Uses argument list (not shlex), absolute paths,
        and no POSIX quoting to prevent WinError 2.
        Launches optimizer script_path with proper args, validates GUI inputs,
        and logs output into GUI. This function supports both legacy flags
        (--A_min etc.) and the new --config flag usage.
        """

        # Ensure optimizer_input.csv exists
        input_file = Path(self.output_dir.get() or "output") / "optimizer_input.csv"
        if not input_file.exists() or input_file.stat().st_size == 0:
            messagebox.showwarning("Missing Input", "Run preprocessing first to generate optimizer_input.csv.")
            return

        # Resolve optimizer script path
        script_path = Path(script_path).resolve()
        if not script_path.exists():
            # Fallback: try config.json alternative path
            cfg_key = "milp_optimizer" if label == "MILP" else "heuristic_optimizer"
            alt = PATHS.get(cfg_key)
            if alt:
                script_path = Path(alt).resolve()

        if not script_path.exists():
            messagebox.showwarning("Missing Script", f"{script_path} not found.")
            return

        # -------------------------
        # Validate numeric fields
        # -------------------------
        def is_int_string(s):
            try:
                int(s)
                return True
            except:
                return False

        fields = [
            ("A_min", self.A_min.get()),
            ("A_max", self.A_max.get()),
            ("A_step", self.A_step.get()),
            ("C_min", self.C_min.get()),
            ("C_max", self.C_max.get()),
            ("C_step", self.C_step.get()),
            ("H", self.H.get())
        ]

        for name, val in fields:
            if not val.strip():
                messagebox.showwarning("Missing Input", f"Please provide {name}.")
                return
            if not is_int_string(val):
                messagebox.showwarning("Invalid Input", f"{name} must be an integer.")
                return

        # -------------------------
        # Build safe argument list
        # -------------------------
        input_file = input_file.resolve()

        cmd_list = [
            sys.executable,                      # Python interpreter
            str(script_path),                    # Optimizer script
            "--input", str(input_file),
            "--A_min", self.A_min.get(),
            "--A_max", self.A_max.get(),
            "--A_step", self.A_step.get(),
            "--C_min", self.C_min.get(),
            "--C_max", self.C_max.get(),
            "--C_step", self.C_step.get(),
            "--H", self.H.get(),
            "--config", "config.json"            # Always supply config.json
        ]

        # Append optional flags
        if self.save_validation.get():
            cmd_list.append("--save_validation")
        if self.save_summary.get():
            cmd_list.append("--save_package_summary")
        if self.save_plots.get():
            cmd_list.append("--save_plots")

        # For debugging/logging only
        self.log("[INFO] Command: " + " ".join(f"\"{c}\"" if " " in c else c for c in cmd_list))

        # -------------------------
        # Run optimizer in background thread
        # -------------------------
        def worker():
            self.progress.config(mode="indeterminate")
            self.progress.start(15)

            try:
                proc = subprocess.Popen(
                    cmd_list,
                    shell=False,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    text=True
                )

                # Stream logs line-by-line
                for line in iter(proc.stdout.readline, ''):
                    if not line:
                        break
                    self.log(f"[{label}] {line.strip()}")

                proc.wait()

                if proc.returncode == 0:
                    self.log(f"[INFO] {label} optimizer finished successfully.")
                else:
                    self.log(f"[ERROR] {label} optimizer exited with code {proc.returncode}")

                # Auto-open plots if user enabled it
                if self.save_plots.get() and self.auto_open_plots.get():
                    try:
                        self.open_output_folder()
                    except:
                        pass

                # Remember last session
                if self.remember_last_session.get():
                    try:
                        update_config("config.json", "defaults", "H", int(self.H.get()))
                        update_config("config.json", "defaults", "A_min", int(self.A_min.get()))
                        update_config("config.json", "defaults", "A_max", int(self.A_max.get()))
                        update_config("config.json", "defaults", "A_step", int(self.A_step.get()))
                        update_config("config.json", "defaults", "C_min", int(self.C_min.get()))
                        update_config("config.json", "defaults", "C_max", int(self.C_max.get()))
                        update_config("config.json", "defaults", "C_step", int(self.C_step.get()))

                        update_config("config.json", "frontend", "remember_last_session", bool(self.remember_last_session.get()))
                        update_config("config.json", "frontend", "auto_open_plots", bool(self.auto_open_plots.get()))
                    except Exception as e:
                        self.log(f"[WARN] Failed to save config.json: {e}")

            except Exception as e:
                self.log(f"[ERROR] {label} run failed: {e}")
                self.log(traceback.format_exc())

            finally:
                try:
                    self.progress.stop()
                    self.progress.config(mode="determinate")
                    self.progress["value"] = 0
                except:
                    pass

        threading.Thread(target=worker, daemon=True).start()

    # -------------------------
    # Utility: check presence of optimizer scripts and warn
    # -------------------------
    def _warn_missing_scripts(self):
        missing = []
        for key, script in [("preprocessing", PATHS.get("preprocessing_script", DEFAULT_PREPROCESSING_SCRIPT)),
                            ("baseline", PATHS.get("heuristic_optimizer", DEFAULT_BASELINE_SCRIPT)),
                            ("milp", PATHS.get("milp_optimizer", DEFAULT_MILP_SCRIPT))]:
            if not Path(script).exists():
                missing.append((key, script))
        if missing:
            for k, s in missing:
                self.log(f"[WARN] Script for {k} not found: {s}")

    # -------------------------
    # Comparison tool: Baseline vs MILP
    # Reads expected package_summary files and shows a quick comparison plot.
    # -------------------------
    def compare_results(self):
        """
        Compare baseline vs milp package summaries:
        - looks for package_summary_baseline.csv and package_summary_milp.csv
        - if absent, try fallback names (package_summary.csv, milp_pkg_summary_A{A}_C{C}.csv)
        - Displays a quick barplot (requires pandas & matplotlib)
        """
        if pd is None or plt is None:
            messagebox.showwarning("Dependencies", "pandas and matplotlib are required for comparison plotting.")
            return

        outdir = Path(self.output_dir.get() or "output")
        # candidate filenames
        baseline_files = [
            outdir / "baseline_package_summary.csv",
            outdir / "package_summary_baseline.csv",
            outdir / "package_summary_baseline_A.csv"
        ]
        milp_files = [
            outdir / "milp_package_summary.csv",
            outdir / "package_summary_milp.csv",
            outdir / "milp_pkg_summary_A{A}_C{C}.csv"
        ]

        # Try to find baseline file
        base_path = None
        for p in baseline_files:
            if p.exists():
                base_path = p
                break
        # Try generic fallback
        if base_path is None:
            # try package_summary.csv (maybe baseline wrote it)
            p = outdir / "package_summary.csv"
            if p.exists():
                base_path = p

        milp_path = None
        for p in milp_files:
            if isinstance(p, Path) and p.exists():
                milp_path = p
                break
        if milp_path is None:
            # find any file starting with milp_pkg_summary
            for f in outdir.glob("milp_pkg_summary*.csv"):
                milp_path = f
                break
        # If no files found, notify
        if base_path is None and milp_path is None:
            messagebox.showinfo("No results", "No package_summary files found for Baseline or MILP in output folder.")
            return

        # Read whichever exists and compute total cost if available
        def read_summary(p):
            try:
                df = pd.read_csv(p)
                # attempt to find a cost column by name fallbacks
                cost_col = None
                for c in ['total_incurred', 'total_cost', 'TotalCost', 'total_with_opportunity', 'total']:
                    if c in df.columns:
                        cost_col = c
                        break
                total_cost = float(df[cost_col].sum()) if cost_col is not None else None
                total_mh = df['total_mh'].sum() if 'total_mh' in df.columns else None
                return {'path': p, 'df': df, 'total_cost': total_cost, 'total_mh': total_mh}
            except Exception:
                return {'path': p, 'df': None, 'total_cost': None, 'total_mh': None}

        base_info = read_summary(base_path) if base_path else None
        milp_info = read_summary(milp_path) if milp_path else None

        # Build plot
        labels = []
        costs = []
        if base_info:
            labels.append("Baseline")
            costs.append(base_info.get('total_cost') or 0.0)
        if milp_info:
            labels.append("MILP")
            costs.append(milp_info.get('total_cost') or 0.0)

        if not labels:
            messagebox.showinfo("No usable data", "Found summary files but couldn't parse cost data to compare.")
            return

        # Simple barplot
        try:
            fig, ax = plt.subplots(figsize=(6, 4))
            ax.bar(labels, costs)
            ax.set_ylabel("Total Cost (USD)")
            ax.set_title("Cost Comparison (Baseline vs MILP)")
            for i, v in enumerate(costs):
                ax.text(i, v + max(1.0, v*0.02), f"{v:,.0f}", ha='center')
            plt.tight_layout()
            plt.show()
        except Exception as e:
            messagebox.showerror("Plot Error", f"Failed to draw comparison plot: {e}")

