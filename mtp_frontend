# -------------------------
# Helper: Config loader/updater
# -------------------------
def load_config(path="config.json"):
    """Safely load JSON config; return {} on any failure."""
    if os.path.exists(path):
        try:
            with open(path, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception as e:
            print(f"[WARN] Could not read config.json: {e}", file=sys.stderr)
            return {}
    return {}

def update_config(path="config.json", section_key=None, key=None, value=None):
    """
    Update a value in config.json safely. section_key is top-level key (e.g., 'defaults').
    Use only for short writes (called when user chooses 'remember last session').
    """
    cfg = load_config(path)
    if section_key is None:
        # overwrite top-level if value is dict
        if isinstance(value, dict):
            cfg.update(value)
        else:
            raise ValueError("Must provide section_key when value is not a dict")
    else:
        if section_key not in cfg or not isinstance(cfg.get(section_key), dict):
            cfg[section_key] = {}
        cfg[section_key][key] = value
    try:
        with open(path, "w", encoding="utf-8") as f:
            json.dump(cfg, f, indent=2)
    except Exception as e:
        print(f"[WARN] Failed to update config.json: {e}", file=sys.stderr)

